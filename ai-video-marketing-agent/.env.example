# Copia este archivo como .env y rellena SOLO lo que vayas a usar.
# .env está excluido de Git. Nunca subas claves al repositorio.

# Voz en off natural (de pago). Además hay que activar permissions.allow_paid_apis
# y subir limits.max_estimated_cost_usd en video-agent.yaml.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vídeos y fotos de stock (gratuita, licencia Pexels). Requiere
# permissions.allow_network_asset_search: true
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Modelo Whisper: nombre (tiny, base, small, medium, large-v3) o ruta local a un
# modelo CTranslate2 (útil sin acceso a huggingface.co)
VIDEO_AGENT_WHISPER_MODEL=small

# Configuración adicional opcional
# VIDEO_AGENT_SETTINGS=/ruta/a/video-agent.yaml
